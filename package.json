{
  "name": "deskglass",
  "productName": "DeskGlass",
  "version": "1.0.0",
  "description": "Dark-glass desktop widgets for Windows 11",
  "author": "ItsTheBoyLuc",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/ItsTheBoyLuc/deskglass",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsTheBoyLuc/deskglass.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "koffi": "^3.3.8",
    "node-ical": "^0.27.6",
    "systeminformation": "^5.33.23"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
